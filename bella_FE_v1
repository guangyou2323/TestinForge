<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FreshSafe - Meat Freshness Scanner</title>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        .screen { display: none; } 
        .screen.active { display: block; }
        body { margin: 0; font-family: sans-serif; background-color: #f5f5f5; }
        
        .btn-style { padding: 10px 15px; margin: 5px; cursor: pointer; border-radius: 5px; border: 1px solid #ccc; background: #fff; display: inline-block; }
        
        /* ===== 相機取景框樣式 ===== */
        .camera-viewfinder { 
            position: relative; 
            display: flex; 
            justify-content: center; 
            margin: 20px 0; 
            background: #000;
            width: 100%;
            max-width: 400px;
            margin: 20px auto;
            overflow: hidden;
            border-radius: 10px;
        }
        #camera-stream { width: 100%; display: block; }
        
        /* 遮罩層和取景框 */
        .camera-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none; /* 让點擊事件穿透 */
        }
        .focus-frame {
            width: 60%; /* 取景框大小 */
            aspect-ratio: 1 / 1; /* 正方形 */
            border: 2px dashed #fff;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5); /* 遮罩效果 */
            position: relative;
        }
        .focus-frame::after {
            content: "Align pH Paper Here";
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            color: #fff;
            font-size: 12px;
            white-space: nowrap;
        }
        
        /* 其他樣式保持不變 */
        .result-box { padding: 20px; text-align: center; border-radius: 10px; margin: 20px 0; border: 2px solid #ccc; }
        .status-fresh { background-color: #d4edda; color: #155724; border-color: #c3e6cb; }
        .status-edible { background-color: #fff3cd; color: #856404; border-color: #ffeeba; }
        .status-spoiled { background-color: #f8d7da; color: #721c24; border-color: #f5c6cb; }

        .progress-container { width: 100%; background-color: #e0e0e0; border-radius: 5px; margin: 20px 0; overflow: hidden; height: 15px;}
        .progress-bar { height: 100%; background-color: #007bff; width: 0%; transition: width 0.1s linear; }

        #preview-container { display: none; margin-top: 15px; text-align: center; }
        #preview-image { max-width: 150px; max-height: 150px; border-radius: 8px; border: 2px solid #28a745; object-fit: cover; }
        #upload-success-text { color: #28a745; font-weight: bold; margin-top: 5px; display: block; }

        #screenshot-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 999; flex-direction: column; justify-content: center; align-items: center; }
        #screenshot-img { max-width: 90%; max-height: 70vh; border-radius: 10px; border: 3px solid #fff; }
        #screenshot-modal p { color: white; margin-top: 15px; font-size: 16px; text-align: center;}
        .close-modal-btn { margin-top: 10px; padding: 10px 20px; background: #fff; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; }

        .error-msg { color: #dc3545; font-size: 13px; margin-top: 5px; display: none; font-weight: bold; }
        .input-error { border: 1px solid #dc3545 !important; background-color: #fff8f8; }
    </style>
</head>
<body>

    <div id="app-container">
        
        <!-- Phase I: Input Screen -->
        <section id="screen-phase-1" class="screen active">
            <header class="app-header">
                <h1>Ourname</h1>
            </header>

            <main class="content">
                <div class="upload-section" id="ph-paper-upload" style="margin-bottom: 20px;">
                    <p>Please upload or take a picture of pH paper <span style="color:red;">*</span></p>
                    <input type="file" id="ph-paper-file-upload" accept="image/*" style="display: none;">
                    
                    <div class="action-buttons" id="action-buttons-container">
                        <label for="ph-paper-file-upload" class="btn-style">📁 Upload from Gallery</label>
                        <button id="btn-go-to-camera" class="btn-style">📷 Take Photo</button>
                    </div>

                    <div id="preview-container">
                        <img id="preview-image" src="" alt="Uploaded pH Paper">
                        <span id="upload-success-text">✅ Image loaded successfully!</span>
                    </div>
                    <span id="error-photo" class="error-msg">⚠️ Please upload or take a photo of the pH paper.</span>
                </div>

                <div class="meat-type-section" style="margin-bottom: 20px;">
                    <label>Meat Type <span style="color:red;">*</span></label>
                    <div class="scroll-options" id="meat-type-options">
                        <label class="option-btn"><input type="radio" name="meat_type" value="beef"> Beef</label>
                        <label class="option-btn"><input type="radio" name="meat_type" value="fish"> Fish</label>
                        <label class="option-btn"><input type="radio" name="meat_type" value="pork"> Pork</label>
                        <label class="option-btn"><input type="radio" name="meat_type" value="lamb"> Lamb</label>
                        <label class="option-btn"><input type="radio" name="meat_type" value="duck"> Duck</label>
                    </div>
                    <span id="error-meat" class="error-msg">⚠️ Please select a meat type.</span>
                </div>

                <div class="purchase-date-section" style="margin-bottom: 20px;">
                    <label for="purchase-date">Purchase date <span style="color:red;">*</span></label>
                    <input type="date" id="purchase-date" name="purchase_date">
                    <div class="forgot-date-wrapper">
                        <input type="checkbox" id="forgot-date" name="forgot_date">
                        <label for="forgot-date">I forgot it!</label>
                    </div>
                    <span id="error-date" class="error-msg">⚠️ Please select a date or check "I forgot it!".</span>
                </div>

                <button id="btn-submit" class="primary-btn">Submit</button>
            </main>
        </section>


        <!-- Camera View (帶有取景框) -->
        <section id="screen-camera" class="screen">
            <header class="app-header">
                <h1>Photo Taking</h1>
            </header>
            <main class="content camera-content">
                <p class="camera-instruction">請將pH試紙放至白色膠片框裡<br>(Please align the pH paper in the frame)</p>
                
                <div class="camera-viewfinder">
                    <video id="camera-stream" autoplay playsinline></video>
                    <canvas id="camera-canvas" style="display: none;"></canvas>
                    
                    <!-- 新增：取景框遮罩層 -->
                    <div class="camera-overlay">
                        <div class="focus-frame" id="focus-frame"></div>
                    </div>
                </div>
                
                <button id="btn-capture" class="shutter-btn" aria-label="Take Photo">
                    <span class="shutter-inner">📸 Take Photo</span>
                </button>
            </main>
        </section>


        <!-- Phase II: Waiting / Processing Screen -->
        <section id="screen-phase-2" class="screen">
            <header class="app-header">
                <h1>Ourname</h1>
            </header>
            <main class="content loading-content">
                <h2>Please wait a moment</h2>
                <div class="progress-container">
                    <div class="progress-bar" id="progress-bar" style="width: 0%;"></div>
                </div>
                <div class="fun-fact-section">
                    <p>ℹ️ Do you know?</p>
                    <p id="fun-fact-text">Loading a fun fact...</p>
                </div>
            </main>
        </section>


        <!-- Phase III: Output / Result Screen -->
        <section id="screen-phase-3" class="screen">
            <header class="app-header">
                <h1>Ourname</h1>
            </header>
            <main class="content result-content" id="capture-area" style="background: #f5f5f5; padding: 20px;">
                <p id="confidence-text">We are <span id="confidence-value">--</span>% sure that the meat is</p>
                
                <div class="result-box status-default" id="result-box">
                    <h2 id="result-status">Waiting...</h2>
                </div>

                <div class="ph-value-section">
                    <p>ℹ️ pH ≈ <span id="ph-value">--</span></p>
                    <!-- 新增：顯示 RGB 數據，證明程序真的讀取了 -->
                    <p style="font-size:12px; color:#666;">(Sampled RGB: <span id="rgb-value">--</span>)</p>
                </div>

                <div class="result-images">
                    <div class="image-container">
                        <p>pH picture:</p>
                        <div class="placeholder-img" id="result-ph-img" style="background:#ddd; height:100px; display:flex; align-items:center; justify-content:center; overflow: hidden; border-radius: 8px;">[Image Placeholder]</div>
                    </div>
                </div>

                <div class="result-actions" style="margin-top: 20px;">
                    <button id="btn-screenshot" class="secondary-btn">Take a screen shot</button>
                    <button id="btn-scan-again" class="primary-btn">Scan again</button>
                </div>
            </main>
        </section>

        <div id="screenshot-modal">
            <p>Screenshot generated!<br><strong>Long press / Right-click to save</strong></p>
            <img id="screenshot-img" src="" alt="Screenshot">
            <button class="close-modal-btn" id="btn-close-modal">Close</button>
        </div>

    </div>

    <script>
        const screens = document.querySelectorAll('.screen');
        
        // Phase I 元素
        const fileUploadInput = document.getElementById('ph-paper-file-upload');
        const btnGoToCamera = document.getElementById('btn-go-to-camera');
        const btnSubmit = document.getElementById('btn-submit');
        const errorPhoto = document.getElementById('error-photo');
        const errorMeat = document.getElementById('error-meat');
        const errorDate = document.getElementById('error-date');
        const dateInput = document.getElementById('purchase-date');
        const forgotDateCheckbox = document.getElementById('forgot-date');
        const actionButtonsContainer = document.getElementById('action-buttons-container');
        const previewContainer = document.getElementById('preview-container');
        const previewImage = document.getElementById('preview-image');
        
        // 相機元素
        const videoElement = document.getElementById('camera-stream');
        const canvasElement = document.getElementById('camera-canvas');
        const btnCapture = document.getElementById('btn-capture');
        const focusFrame = document.getElementById('focus-frame');
        
        // Phase II 元素
        const progressBar = document.getElementById('progress-bar');
        const funFactText = document.getElementById('fun-fact-text');
        
        // Phase III 元素
        const resultBox = document.getElementById('result-box');
        const resultStatus = document.getElementById('result-status');
        const phValueText = document.getElementById('ph-value');
        const confidenceValueText = document.getElementById('confidence-value');
        const rgbValueText = document.getElementById('rgb-value'); // 新增
        
        // 截圖元素
        const btnScreenshot = document.getElementById('btn-screenshot');
        const screenshotModal = document.getElementById('screenshot-modal');
        const screenshotImg = document.getElementById('screenshot-img');
        const btnCloseModal = document.getElementById('btn-close-modal');

        let stream = null;
        let progressInterval = null;
        let hasUploadedImage = false; 
        let currentImageURL = null; 
        
        // 新增：存儲從取景框讀取到的 RGB 數據
        let sampledRGB = { r: 0, g: 0, b: 0 };

        const funFacts = [
            "H₂O is good, but H₂O isn't good.",
            "Meat spoils faster at room temperature than in the fridge.",
            "pH stands for 'potential of hydrogen'.",
            "Color blindness affects 1 in 12 men and 1 in 200 women globally.",
            "Always wash your hands before handling raw meat.",
            "The pH scale ranges from 0 to 14, with 7 being neutral."
        ];

        function showScreen(screenId) {
            screens.forEach(screen => screen.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }

        function validateForm() {
            let isValid = true;
            if (!hasUploadedImage) { errorPhoto.style.display = 'block'; isValid = false; } else { errorPhoto.style.display = 'none'; }
            const selectedMeat = document.querySelector('input[name="meat_type"]:checked');
            if (!selectedMeat) { errorMeat.style.display = 'block'; isValid = false; } else { errorMeat.style.display = 'none'; }
            if (!dateInput.value && !forgotDateCheckbox.checked) {
                errorDate.style.display = 'block'; dateInput.classList.add('input-error'); isValid = false;
            } else {
                errorDate.style.display = 'none'; dateInput.classList.remove('input-error');
            }
            return isValid;
        }

        forgotDateCheckbox.addEventListener('change', function() {
            if (this.checked) { errorDate.style.display = 'none'; dateInput.classList.remove('input-error'); dateInput.value = ''; }
        });
        dateInput.addEventListener('input', function() {
            if (this.value) { errorDate.style.display = 'none'; dateInput.classList.remove('input-error'); forgotDateCheckbox.checked = false; }
        });

        // 1. 上傳照片
        fileUploadInput.addEventListener('change', function(event) {
            if (event.target.files && event.target.files[0]) {
                if (currentImageURL && currentImageURL.startsWith('blob:')) URL.revokeObjectURL(currentImageURL);
                currentImageURL = URL.createObjectURL(event.target.files[0]);
                previewImage.src = currentImageURL;
                previewContainer.style.display = 'block';
                actionButtonsContainer.style.display = 'none';
                hasUploadedImage = true;
                errorPhoto.style.display = 'none';
                
                // 如果是上傳的照片，我們沒有取景框，就取中心區域模擬讀取 RGB
                simulateUploadRGB();
            }
        });

        // 模擬上傳圖片的RGB
        function simulateUploadRGB() {
            const img = new Image();
            img.onload = function() {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = img.width; canvas.height = img.height;
                ctx.drawImage(img, 0, 0);
                // 取中心 10x10 像素
                const centerX = img.width / 2; const centerY = img.height / 2;
                const data = ctx.getImageData(centerX - 5, centerY - 5, 10, 10).data;
                let r=0, g=0, b=0;
                for(let i=0; i<data.length; i+=4) { r+=data[i]; g+=data[i+1]; b+=data[i+2]; }
                sampledRGB = { r: Math.round(r/100), g: Math.round(g/100), b: Math.round(b/100) };
            };
            img.src = currentImageURL;
        }

        btnSubmit.addEventListener('click', function() {
            if (validateForm()) { generateResult(); showScreen('screen-phase-3'); }
        });

        // 2. 相機拍照
        btnGoToCamera.addEventListener('click', async function() {
            errorPhoto.style.display = 'none';
            let isValid = true;
            const selectedMeat = document.querySelector('input[name="meat_type"]:checked');
            if (!selectedMeat) { errorMeat.style.display = 'block'; isValid = false; }
            if (!dateInput.value && !forgotDateCheckbox.checked) { errorDate.style.display = 'block'; dateInput.classList.add('input-error'); isValid = false; }
            if (!isValid) { alert("Please fill in the meat type and purchase date before taking a photo."); return; }

            showScreen('screen-camera');
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
                videoElement.srcObject = stream;
            } catch (err) { alert("无法訪問摄像頭，請確保在 HTTPS 環境下運行。"); }
        });

        function stopCamera() {
            if (stream) { stream.getTracks().forEach(track => track.stop()); videoElement.srcObject = null; }
        }

        // 3. 點擊快門：截圖並提取取景框 RGB
        btnCapture.addEventListener('click', function() {
            if (!stream) return;

            const maxWidth = 800; 
            const videoWidth = videoElement.videoWidth;
            const videoHeight = videoElement.videoHeight;
            
            let targetWidth = videoWidth; let targetHeight = videoHeight;
            if (videoWidth > maxWidth) {
                targetWidth = maxWidth;
                targetHeight = Math.round((videoHeight * maxWidth) / videoWidth);
            }

            canvasElement.width = targetWidth;
            canvasElement.height = targetHeight;
            const context = canvasElement.getContext('2d');
            context.drawImage(videoElement, 0, 0, targetWidth, targetHeight);
            
            // 保存整張照片供顯示
            currentImageURL = canvasElement.toDataURL('image/jpeg', 0.8);

            // ==========================================
            // 核心：提取取景框內的 RGB 值
            // ==========================================
            // 計算取景框在 canvas 中的位置 (取景框寬度是 60%)
            const frameWidth = targetWidth * 0.6;
            const frameHeight = targetWidth * 0.6; // 正方形
            const startX = (targetWidth - frameWidth) / 2;
            const startY = (targetHeight - frameHeight) / 2;

            // 獲取該區域的像素數據
            const imageData = context.getImageData(startX, startY, frameWidth, frameHeight);
            const data = imageData.data;

            // PRD 要求：獲取 5 個指定像素。我們取四個角和中心點。
            const points = [
                { x: Math.floor(frameWidth * 0.1), y: Math.floor(frameHeight * 0.1) }, // 左上
                { x: Math.floor(frameWidth * 0.9), y: Math.floor(frameHeight * 0.1) }, // 右上
                { x: Math.floor(frameWidth * 0.5), y: Math.floor(frameHeight * 0.5) }, // 中心
                { x: Math.floor(frameWidth * 0.1), y: Math.floor(frameHeight * 0.9) }, // 左下
                { x: Math.floor(frameWidth * 0.9), y: Math.floor(frameHeight * 0.9) }  // 右下
            ];

            let totalR = 0, totalG = 0, totalB = 0;
            
            points.forEach(p => {
                // 計算該點在 imageData.data 中的索引
                const idx = (p.y * frameWidth + p.x) * 4;
                totalR += data[idx];
                totalG += data[idx + 1];
                totalB += data[idx + 2];
            });

            // 計算平均值
            sampledRGB = { 
                r: Math.round(totalR / 5), 
                g: Math.round(totalG / 5), 
                b: Math.round(totalB / 5) 
            };

            console.log("Sampled RGB:", sampledRGB);

            stopCamera();
            showScreen('screen-phase-2');
            startProcessing();
        });

        // 4. Phase II 等待邏輯
        function startProcessing() {
            progressBar.style.width = '0%';
            funFactText.innerText = funFacts[Math.floor(Math.random() * funFacts.length)];
            let progress = 0;
            if (progressInterval) clearInterval(progressInterval);

            progressInterval = setInterval(() => {
                progress += Math.random() * 5 + 1; 
                if (progress >= 100) {
                    progress = 100;
                    progressBar.style.width = '100%';
                    clearInterval(progressInterval);
                    setTimeout(() => { generateResult(); showScreen('screen-phase-3'); }, 500);
                } else {
                    progressBar.style.width = progress + '%';
                }
            }, 100);
        }

        // 5. 根據 RGB 生成結果 (模擬算法)
        function generateResult() {
            let mockPH = 7.0;
            let mockConfidence = 85;
            let statusText = "";
            let statusClass = "";

            // 簡單的模擬算法：根據 R 和 B 的比例決定 pH
            // (僅供演示：一般試紙變紅偏酸，變藍/紫偏鹼)
            const { r, g, b } = sampledRGB;
            
            // 如果沒讀到 RGB (比如純黑)，就用隨機值兜底
            if (r === 0 && g === 0 && b === 0) {
                mockPH = (Math.random() * 3 + 5.0).toFixed(1); 
            } else {
                // 這只是一個純前端的假算法，用 R 和 B 的差值來模擬 pH 變化
                const diff = (b - r) / 255 * 3; 
                mockPH = (6.5 + diff).toFixed(1);
            }

            // 限制 pH 範圍在 4.0 到 9.0 之間，防止算出來太離譜
            mockPH = Math.max(4.0, Math.min(9.0, parseFloat(mockPH))).toFixed(1);

            if (mockPH < 6.0) {
                statusText = "Fresh"; statusClass = "status-fresh";
            } else if (mockPH >= 6.0 && mockPH <= 6.8) {
                statusText = "Edible"; statusClass = "status-edible";
            } else {
                statusText = "Spoiled"; statusClass = "status-spoiled";
            }

            // 更新 UI
            phValueText.innerText = mockPH;
            confidenceValueText.innerText = mockConfidence;
            resultStatus.innerText = statusText;
            resultBox.className = 'result-box ' + statusClass;
            
            // 顯示讀取到的 RGB
            rgbValueText.innerText = `R:${sampledRGB.r}, G:${sampledRGB.g}, B:${sampledRGB.b}`;

            if (currentImageURL) {
                document.getElementById('result-ph-img').innerHTML = `<img src="${currentImageURL}" style="width:100%; height:100%; object-fit:cover;">`;
            }
        }

        // 6. 截圖
        btnScreenshot.addEventListener('click', function() {
            const captureArea = document.getElementById('capture-area');
            const resultActions = document.querySelector('.result-actions');
            resultActions.style.visibility = 'hidden';

            html2canvas(captureArea, { backgroundColor: "#f5f5f5", scale: 2 }).then(canvas => {
                screenshotImg.src = canvas.toDataURL('image/png');
                screenshotModal.style.display = 'flex';
                resultActions.style.visibility = 'visible';
            }).catch(err => {
                alert("截图失败，请重试");
                resultActions.style.visibility = 'visible';
            });
        });

        btnCloseModal.addEventListener('click', function() { screenshotModal.style.display = 'none'; });

        // 7. 重新掃描
        document.getElementById('btn-scan-again').addEventListener('click', function() {
            if (currentImageURL && currentImageURL.startsWith('blob:')) URL.revokeObjectURL(currentImageURL);
            currentImageURL = null; hasUploadedImage = false; fileUploadInput.value = ''; 
            actionButtonsContainer.style.display = 'block'; previewContainer.style.display = 'none'; previewImage.src = '';
            document.querySelectorAll('input[name="meat_type"]').forEach(radio => radio.checked = false);
            dateInput.value = ''; forgotDateCheckbox.checked = false;
            errorMeat.style.display = 'none'; errorDate.style.display = 'none'; errorPhoto.style.display = 'none';
            dateInput.classList.remove('input-error');
            showScreen('screen-phase-1');
        });

    </script>
</body>
</html>
